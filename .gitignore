/target

# Local configuration with secrets (TransportAPI keys, private calendar URLs).
# Copy settings.example.toml to settings.toml and edit it.
/settings.toml

# Google service-account key files (private keys — never commit).
google-service-account.json
*service-account*.json

# On-disk cache/history database for external API calls.
/cache.sqlite
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Generated preview / render images.
*.png
